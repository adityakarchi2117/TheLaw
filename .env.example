# ─────────────────────────────────────────────
# LLM Providers (Groq or Google Gemini — both offer free tiers)
# ─────────────────────────────────────────────
# Provider: 'auto', 'groq', or 'gemini' (auto selects whichever key is provided)
LLM_PROVIDER=auto

# Option 1: Groq (Ultra-fast inference — get free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# Recommended Groq models: llama-3.3-70b-versatile, llama3-8b-8192, openai/gpt-oss-20b, gemma2-9b-it

# Option 2: Google Gemini (Generous free tier — get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended Gemini models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro

# Model override (optional; leave blank or omit to use provider default)
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ─────────────────────────────────────────────
# AWS S3 (Optional — for document storage)
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-legal-ai-bucket-name

# ─────────────────────────────────────────────
# RAG Settings (Optional — defaults shown)
# ─────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_TOP_K=4
